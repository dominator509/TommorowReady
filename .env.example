# TomorrowReady environment template. Copy to .env and replace local values. Never commit .env.
POSTGRES_PASSWORD=replace_with_secure_local_database_password
POSTGRES_APP_PASSWORD=replace_with_distinct_secure_local_application_password
DATABASE_MIGRATION_URL=postgresql://tomorrowready:local_owner_only@127.0.0.1:25432/tomorrowready
DATABASE_URL=postgresql://tomorrowready_app:local_app_only@127.0.0.1:25432/tomorrowready
REDIS_URL=redis://127.0.0.1:26379/0
S3_ENDPOINT=http://127.0.0.1:29000
S3_ACCESS_KEY_ID=local_tomorrowready
S3_SECRET_ACCESS_KEY=replace_with_secure_local_secret
S3_BUCKET=tomorrowready-private
SESSION_SECRET=replace_with_32_plus_random_bytes
AUTH_LOOKUP_SECRET=replace_with_distinct_32_plus_random_bytes
RECOVERY_TOKEN_SECRET=replace_with_distinct_32_plus_random_bytes
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000
FIELD_ENCRYPTION_KEY=replace_with_base64_32_byte_key
BACKUP_ENCRYPTION_KEY=replace_with_distinct_base64_32_byte_key
DEEPSEEK_API_KEY=
SMTP_URL=smtp://127.0.0.1:1125
SMS_PROVIDER_TOKEN=
LOB_API_KEY=
LOB_WEBHOOK_SECRET=
POSTGRID_API_KEY=
POSTGRID_WEBHOOK_SECRET=
POSTGRID_RETURN_CONTACT_ID=
PHYSICAL_MAIL_FROM_NAME=
PHYSICAL_MAIL_FROM_ADDRESS_LINE1=
PHYSICAL_MAIL_FROM_ADDRESS_LINE2=
PHYSICAL_MAIL_FROM_CITY=
PHYSICAL_MAIL_FROM_STATE=
PHYSICAL_MAIL_FROM_POSTAL_CODE=
PHYSICAL_MAIL_FROM_COUNTRY_CODE=US
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KMS_KEY_ID=
SENTRY_DSN=
LEGAL_APPROVAL_RECORD=
VENDOR_RISK_APPROVAL_RECORD=
INSURANCE_EVIDENCE_RECORD=
PRODUCTION_EVIDENCE_FILE=
PRODUCTION_EVIDENCE_SHA256=
PRODUCTION_BASE_URL=
RELEASE_COMMIT=
PRODUCTION_MANIFEST=
PRODUCTION_MANIFEST_SHA256=
ROLLBACK_MANIFEST=
